{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(entrar|treinos|planilha|api/.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "fttraining.vercel.app" }],
      "destination": "https://www.fttraining.com.br/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "fttraining.vercel.app" }],
      "destination": "https://www.fttraining.com.br/:path*",
      "permanent": true
    }
  ]
}
