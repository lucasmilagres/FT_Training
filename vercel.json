{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(entrar|treinos|planilha|aluno|coach|app|api/.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/app.webmanifest",
      "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "fttraining.vercel.app" }],
      "destination": "https://www.fttraining.com.br/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "fttraining.vercel.app" }],
      "destination": "https://www.fttraining.com.br/:path*",
      "permanent": true
    }
  ]
}
