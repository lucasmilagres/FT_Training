# Variáveis da área do coach. Na Vercel: Project → Settings → Environment Variables.
# Para testar local, copie para .env.local (fica fora do git) e rode: node scripts/dev.js

# Chave da API do Resend (resend.com → API Keys). Permissão "Sending access" basta.
RESEND_API_KEY=

# Texto aleatório longo (mínimo 32 caracteres) que assina o login. Trocar desloga todo mundo.
SESSION_SECRET=

# E-mails que podem entrar, separados por vírgula
TREINOS_EMAILS=metodotanaka@gmail.com

# Link CSV da planilha: Google Sheets → Arquivo → Compartilhar → Publicar na Web →
# escolha a aba dos treinos + "Valores separados por vírgula (.csv)" → Publicar → copie o link
TREINOS_PLANILHA=

# Opcional: remetente do e-mail (precisa ser do domínio verificado no Resend)
# EMAIL_REMETENTE=FT Training <acesso@fttraining.com.br>
