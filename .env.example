# Variáveis da área do coach. Na Vercel: Project → Settings → Environment Variables.
# Para testar local, copie para .env.local (fica fora do git) e rode: node scripts/dev.js

# Chave da API do Resend (resend.com → API Keys). Permissão "Sending access" basta.
RESEND_API_KEY=

# Texto aleatório longo (mínimo 32 caracteres) que assina o login. Trocar desloga todo mundo.
SESSION_SECRET=

# E-mails que podem entrar, separados por vírgula
TREINOS_EMAILS=metodotanaka@gmail.com

# Robô do Google que lê a planilha privada do coach (conta de serviço do projeto FT Training
# no Google Cloud, com a API do Google Sheets ativada). Valor = conteúdo inteiro do arquivo .json da chave.
# O coach liga a planilha sozinho em /planilha: cola o link e compartilha com o e-mail do robô como Leitor.
GOOGLE_SERVICE_ACCOUNT=

# "Entrar com Google" em /planilha (cliente OAuth "Aplicativo da Web" do mesmo projeto no Google Cloud).
# URI de redirecionamento cadastrada: https://www.fttraining.com.br/api/google/retorno
# Escopos: openid, email, drive.file (o site só vê a planilha escolhida no Google Picker).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chave de API do Google Picker (restrita ao site www.fttraining.com.br e à Google Picker API)
GOOGLE_API_KEY=

# Criada pela Vercel ao ligar o Blob store privado "ft-config" (guarda o link da planilha e a conexão Google)
BLOB_READ_WRITE_TOKEN=

# Reserva (opcional): link CSV "Publicar na Web". Só é usado se nenhuma planilha foi ligada em /planilha.
# TREINOS_PLANILHA=

# Opcional: remetente do e-mail (precisa ser do domínio verificado no Resend)
# EMAIL_REMETENTE=FT Training <acesso@fttraining.com.br>
